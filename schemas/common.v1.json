{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.ficium.net/schemas/common.v1.json",
  "title": "Shared definitions, v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code, e.g. MUR"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Decimal fraction: 0.0425 means 4.25% a year"
    },
    "term_months": {
      "type": "integer",
      "minimum": 1
    },
    "product_type": {
      "type": "string",
      "enum": [
        "sme_loan",
        "personal_loan",
        "mortgage",
        "fixed_deposit",
        "savings_account",
        "credit_card",
        "business_account",
        "investment_account",
        "leasing",
        "overdraft",
        "business_loan",
        "equities",
        "unit_trust",
        "savings_plan",
        "government_bonds",
        "offshore_investment",
        "mixed_portfolio"
      ]
    },
    "request_status": {
      "type": "string",
      "enum": [
        "open",
        "awaiting_consent",
        "accepted",
        "closed",
        "expired",
        "rejected"
      ],
      "description": "Borrower-side vocabulary. The borrower app owns request status."
    },
    "text_body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "benefit": {
      "type": "object",
      "description": "A benefit attached to a bid, frozen when the bid was placed. value_amount and value_unit come together; without them the benefit is wording only.",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "value_display": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_guaranteed": {
          "type": "boolean"
        },
        "cat_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The benefit's value, in value_unit. Decimal fractions like every rate in this contract: a 0.25% rate discount is 0.0025, a 50% fee waiver is 0.5."
        },
        "value_unit": {
          "type": "string",
          "enum": [
            "rate_pa",
            "fee_fraction",
            "amount"
          ],
          "description": "rate_pa: reduction of the yearly rate, as a decimal fraction (0.0025 = 0.25 percentage points). fee_fraction: share of a fee waived, 0 to 1. amount: money in the bid's currency."
        }
      },
      "dependentRequired": {
        "value_amount": [
          "value_unit"
        ],
        "value_unit": [
          "value_amount"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "value_unit"
            ],
            "properties": {
              "value_unit": {
                "const": "rate_pa"
              }
            }
          },
          "then": {
            "properties": {
              "value_amount": {
                "maximum": 0.1
              }
            }
          },
          "$comment": "A rate discount above 10 points is a unit error (0.25 sent for 0.25%), not a benefit."
        },
        {
          "if": {
            "required": [
              "value_unit"
            ],
            "properties": {
              "value_unit": {
                "const": "fee_fraction"
              }
            }
          },
          "then": {
            "properties": {
              "value_amount": {
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hex SHA-256 of the file bytes"
    },
    "document_mime_type": {
      "type": "string",
      "enum": [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ]
    },
    "deal_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "name",
        "provided_by",
        "mandatory",
        "status"
      ],
      "description": "One item of a deal's document checklist. Carries no file names or contents: only what is needed and where it stands.",
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "provided_by": {
          "type": "string",
          "enum": [
            "borrower",
            "bank",
            "third_party"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "stage_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "required",
            "received",
            "verified",
            "rejected",
            "waived"
          ]
        },
        "review_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "Why a document was rejected or waived, written for the borrower"
        },
        "document_type": {
          "oneOf": [
            {
              "$ref": "#/$defs/document_type"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the bank wants a specific kind of document; lets the borrower reuse a matching one."
        },
        "max_age_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3650,
          "description": "Oldest acceptable document, in days, measured from the document's own date (payslip period, statement date). A copy older than this, or whose date is unknown, must be uploaded new."
        }
      }
    },
    "document_type": {
      "type": "string",
      "description": "What kind of document. Matches the borrower vault's types so the borrower can be offered copies they already hold.",
      "enum": [
        "payslip",
        "employment_letter",
        "tax_return",
        "bank_statement",
        "loan_statement",
        "credit_card_statement",
        "title_deed",
        "valuation_report",
        "land_registry_extract",
        "brn_certificate",
        "audited_accounts",
        "insurance_policy",
        "nic",
        "passport",
        "birth_certificate",
        "driving_licence",
        "other"
      ]
    }
  }
}
