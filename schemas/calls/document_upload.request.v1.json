{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.ficium.net/schemas/calls/document_upload.request.v1.json",
  "title": "POST /integration/v1/deal-documents/uploads request body",
  "description": "Borrower asks for a one-time upload slot for one checklist item of a deal it accepted. The file goes straight to storage at upload_url, never through either API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline_id",
    "anon_borrower_id",
    "requirement_id",
    "file_name",
    "mime_type",
    "size_bytes",
    "source"
  ],
  "properties": {
    "pipeline_id": {
      "$ref": "../common.v1.json#/$defs/uuid"
    },
    "anon_borrower_id": {
      "$ref": "../common.v1.json#/$defs/uuid"
    },
    "requirement_id": {
      "$ref": "../common.v1.json#/$defs/uuid"
    },
    "file_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\\\]+$"
    },
    "mime_type": {
      "$ref": "../common.v1.json#/$defs/document_mime_type"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "source": {
      "type": "string",
      "enum": [
        "vault",
        "new"
      ],
      "description": "vault: a copy the borrower already held and chose to share for this deal; new: uploaded for this request."
    },
    "document_date": {
      "oneOf": [
        {
          "$ref": "../common.v1.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ],
      "description": "The document's own date as the borrower side knows it. Required when source is vault."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "vault"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "document_date"
        ],
        "properties": {
          "document_date": {
            "$ref": "../common.v1.json#/$defs/date"
          }
        }
      },
      "$comment": "A reused copy must say what date it covers, so its age can be checked."
    }
  ]
}
